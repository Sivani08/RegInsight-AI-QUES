# Observation intelligence settings (all-source CLI)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_LOCAL_TIMEOUT_SECONDS=300
AI_ENABLE_REMOTE=false
AI_MAX_REQUESTS=20
# Legacy AI_MAX_REQUESTS_PER_RUN remains supported.
AI_TEMPERATURE=0
# Optional installed Ollama model used after Gemini transport/configuration failures.
OLLAMA_FALLBACK_MODEL=
AI_MAX_TEXT_LENGTH=12000
AI_BATCH_SIZE=250
# Requests per minute. Set to your account's actual quota or lower.
AI_RATE_LIMIT=5
# Estimated token guard; server-side 429 remains authoritative.
AI_TOKEN_LIMIT_PER_MINUTE=20000
AI_CACHE_ENABLED=true
AI_TIMEOUT_SECONDS=30
OBSERVATION_SIMILARITY_THRESHOLD=0.78
# Optional preinstalled sentence-transformers model directory; never auto-downloaded.
OBSERVATION_EMBEDDING_MODEL_PATH=
# Local model endpoint needs no API key. Set AI_MODEL to its installed model name.
AI_BASE_URL=http://localhost:11434/v1/chat/completions
DATABASE_URL=postgresql+psycopg://reginsight:CHANGE_ME@127.0.0.1:5432/reginsight

# Optional cache; PostgreSQL remains the persistence authority.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=inspection-insights
REDIS_CACHE_TTL_SECONDS=300
REDIS_CLASSIFICATION_TTL_SECONDS=86400
REDIS_TIMEOUT_SECONDS=0.25
REDIS_MAX_VALUE_BYTES=2000000

# Local chat (independent of observation AI_PROVIDER)
CHAT_MODEL=reginsight-chat:qwen3-1.7b
CHAT_OLLAMA_URL=http://127.0.0.1:11434

# Create individual access keys with: python -m scripts.create_user
REGINSIGHT_ENV=local
REGINSIGHT_ALLOWED_HOSTS=localhost,127.0.0.1,::1
ANTHROPIC_API_KEY=
DASHBOARD_MAX_QUESTION=4000
DASHBOARD_MAX_HISTORY=12

EMBEDDING_MODEL=nomic-embed-text:latest
RETRIEVAL_MODE=hybrid
OLLAMA_ALLOWED_HOSTS=127.0.0.1,localhost,::1
